      "position": [
        704,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst sales = $('Fetch Sales Metrics').first()?.json ?? {};\nconst support = $('Fetch Support Queue').first()?.json ?? {};\nconst finance = $('Fetch Payments').first()?.json ?? {};\n\nconst anomalies = [];\n\nif (typeof sales.conversionRate === 'number' && sales.conversionRate < 0.02) {\n  anomalies.push({ domain: 'Sales', severity: 'high', signal: 'Checkout conversion below 2%', value: sales.conversionRate });\n}\nif (typeof sales.revenueDropPct === 'number' && sales.revenueDropPct > 15) {\n  anomalies.push({ domain: 'Sales', severity: 'critical', signal: 'Hourly revenue drop > 15%', value: sales.revenueDropPct });\n}\nif (typeof support.backlog === 'number' && support.backlog > 200) {\n  anomalies.push({ domain: 'Support', severity: 'medium', signal: 'Ticket backlog over 200', value: support.backlog });\n}\nif (typeof finance.failedPaymentsPct === 'number' && finance.failedPaymentsPct > 5) {\n  anomalies.push({ domain: 'Finance', severity: 'high', signal: 'Payment failure rate > 5%', value: finance.failedPaymentsPct });\n}\n\nconst topSeverity = anomalies.reduce((acc, a) => {\n  const rank = { low: 1, medium: 2, high: 3, critical: 4 };\n  return rank[a.severity] > rank[acc] ? a.severity : acc;\n}, 'low');\n\nreturn [{\n  json: {\n    anomalyCount: anomalies.length,\n    topSeverity,\n    anomalies,\n    snapshot: { sales, support, finance },\n    detectedAt: new Date().toISOString(),\n  },\n}];\n"
      },
      "id": "d314c143-b259-4452-a065-05baab3b4300",
      "name": "Detect Anomalies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        80
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.anomalyCount }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "8793e384-be62-48d2-bbc3-20b816832e7e",
      "name": "Has Anomalies?",
