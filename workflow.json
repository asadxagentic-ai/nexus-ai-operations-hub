        "text": "={{ \"Detected \" + $json.anomalyCount + \" anomalies. Snapshot: \" + JSON.stringify($json.snapshot) + \" Anomalies: \" + JSON.stringify($json.anomalies) }}",
        "options": {
          "systemMessage": "You are the operations hub for a SaaS business. Investigate the provided anomalies across Sales, Support, Infrastructure, and Finance. Identify probable root causes, list 2-4 actionable next steps, propose owning team (Sales, Support, SRE, Finance, or Marketing), and rate executive impact (low/medium/high). Respond with concise Markdown.",
          "maxIterations": 4
        }
      },
